# ==============================================================================
# Curtain Backend & Operator Environment Configuration
# Network: Robinhood Chain Mainnet (Chain ID 4663)
# ==============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Render PostgreSQL Internal Connection String (from Render Postgres dashboard)
# Example: postgres://curtain:password@curtain-db:5432/curtain
DATABASE_URL=postgres://curtain:password@localhost:5432/curtain

# ── Chain & RPC ───────────────────────────────────────────────────────────────
CHAIN_ID=4663
# Robinhood Chain mainnet RPC endpoint (use dedicated provider if available)
RPC_HTTP=https://rpc.mainnet.chain.robinhood.com

# ── Core Protocol Contracts ───────────────────────────────────────────────────
# Deployed Curtain contracts on Robinhood Chain mainnet (contracts/deployments/4663.json)
VAULT_ADDR=0xF9381841e982648c178E762116A437Ecbcf12Bbd
# Optional second vault context served by the same operator process.
V3_VAULT_ADDR=0xBF643c56D6f1775f9ABe97b7B7e89b0265D6c67a
V3_DATABASE_URL=postgresql://user:password@host:5432/curtain_v3
V3_START_BLOCK=83076480
V3_FIXED_AMOUNTS_JSON=default
STAKING_ADDR=0xA0328Ada6694e95D7e946dFD54611BA57ACCA8c8
START_BLOCK=82381998

# ── DEX Routers & Quoters (Robinhood Chain) ───────────────────────────────────
# Uniswap SwapRouter02
DEX_ROUTER_ADDR=0xcaf681a66d020601342297493863e78c959e5cb2
# Uniswap v3 QuoterV2
UNISWAP_QUOTER_ADDR=0x33e885ed0ec9bf04ecfb19341582aadcb4c8a9e7
# Curtain UniswapV4Adapter (deployed)
V4_ADAPTER_ADDR=0x2b50d96a0073baCe9e126fb012d46912298486F0
# Uniswap V4Quoter
V4_QUOTER_ADDR=0x8dc178efb8111bb0973dd9d722ebeff267c98f94
# Route mode: "uniswap" (routes across v3 and v4)
ROUTE=uniswap

# ── Pool V2 (product route V4; remains disabled until deliberate rollout) ──────
POOL_V2_ADDR=0xA6fcb7A43aE6F26c86EA637D8BA9aaA1fd506971
POOL_V2_ROOT_MANAGER_ADDR=0x13197b48E467A306F612D0eFBA745963E914B55F
POOL_V2_START_BLOCK=84297845
# This adapter has exact-output support and is allowlisted by POOL_V2_ADDR only.
POOL_V2_DEX_ADAPTER_ADDR=0x86FACa7029Ac9c8d6a457DA6c38E12b84eba67a7
# Keep the superseded pool indexed so old notes remain recoverable.
POOL_V2_LEGACY_ADDR=0x38147c547cDE831812CD075166E279B77FF164Cc
POOL_V2_LEGACY_ROOT_MANAGER_ADDR=0x51E2aCaC1Fe6b1915D7Eafd24b96B7781cd9AFEf
POOL_V2_LEGACY_START_BLOCK=84199146
# Only flip this on after operator deployment/migration and frontend wiring are ready.
FEATURE_POOL_V2_ROUTE=false

# ── Operator Configuration ────────────────────────────────────────────────────
# Private key of the operator hot wallet (must hold gas ETH, min 0.02 ETH recommended)
OPERATOR_PRIVATE_KEY=0x_YOUR_OPERATOR_PRIVATE_KEY_HERE

# Listening port (Render automatically sets PORT)
PORT=3100
OPERATOR_PORT=3100

# Loop tick interval in milliseconds
TICK_MS=5000

# Slippage tolerance in basis points (50 bps = 0.50%)
SLIPPAGE_BPS=50

# Keeper fee reward in basis points (5 bps = 0.05%)
KEEPER_FEE_BPS=5

# Gas warning threshold for /status (5000000000000000 wei = 0.005 ETH)
MIN_OPERATOR_BALANCE_WEI=5000000000000000

